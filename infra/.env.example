# Plantilla de variables (valores FICTICIOS). Copiar a infra/.env y completar.
# .env NUNCA se versiona (ver .gitignore). Fuente: INFRASTRUCTURE.md §7.

# Base de datos
POSTGRES_DB=paseo
DB_SUPERUSER_PASSWORD=cambia-me-superadmin-solo-init
PASEO_OWNER_PASSWORD=cambia-me-owner-flyway
PASEO_APP_PASSWORD=cambia-me-app-api-worker
PASEO_BACKUP_PASSWORD=cambia-me-backup

# JWT (largo y aleatorio; p. ej. `openssl rand -base64 48`)
JWT_SECRET=cambia-me-secreto-largo-aleatorio
JWT_KID=dev-key-1
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
QR_TOKEN_TTL_SECONDS=60

# Firma de tickets de identificación del comercio (HU-10). Separado de JWT_SECRET:
# no reutilizar. Largo y aleatorio, p. ej. `openssl rand -base64 48`.
# Ticket de identificación ~300 s; QR del cliente ~60 s (QR_TOKEN_TTL_SECONDS).
IDENTIFICATION_SECRET=cambia-me-secreto-identificacion-largo-aleatorio

# OTP y correo (proveedores por decidir; en dev, OTP por consola)
OTP_SENDER=console
# OTP_PROVIDER_API_KEY=
# Correo: adaptador propio SmtpEmailSender contra Gmail / Google Workspace
# (proveedor decidido 03/10/2026; remitente = correo del equipo).
# SMTP_PASSWORD es una CONTRASEÑA DE APLICACIÓN de Google (no la de la cuenta).
# EMAIL_SENDER=console es admisible para pruebas locales sin credenciales.
EMAIL_SENDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# (rellenar SMTP_USER y SMTP_FROM con el correo del equipo)

# Push (cuando se implemente)
# FCM_PROJECT_ID=
# FCM_CREDENTIALS=

# Aplicación
PUBLIC_BASE_URL=https://localhost
PUBLIC_HOST=localhost
PHONE_COUNTRY=BO
UPLOADS_DIR=/data/uploads
UPLOAD_MAX_BYTES=5242880
WEB_MERCHANT_ORIGIN=https://localhost
WEB_ADMIN_ORIGIN=https://localhost:8443

# Reembolsos (valor inicial POR DECIDIR; se confirma en la spec de reembolsos)
REFUND_WINDOW_DAYS=7
# REFUND_REQUEST_TTL_DAYS=30

# Caddy (opcional: restringir la web de administración por IP)
# ADMIN_ALLOWED_IPS=
